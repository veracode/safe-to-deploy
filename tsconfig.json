{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "removeComments": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/tests/**/*",
    "**/*.test.ts"
  ]
}